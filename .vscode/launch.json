{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Extension",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/editors/vscode",
                "${workspaceFolder}/editors/vscode/examples"
            ],
            "outFiles": [
                "${workspaceFolder}/editors/vscode/out/**/*.(m|c|)js"
            ],
            "preLaunchTask": "npm: compile - editors/vscode"
        }
    ]
}
