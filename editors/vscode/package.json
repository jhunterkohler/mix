{
    "name": "language-mixal",
    "displayName": "MIX Assembly Language",
    "description": "MIX assembly language support",
    "version": "1.1.0",
    "engines": {
        "vscode": "^1.91.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "mixal",
                "aliases": [
                    "MIXAL",
                    "mixal"
                ],
                "extensions": [
                    ".mixal"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "mixal",
                "scopeName": "text.mixal",
                "path": "./syntaxes/mixal.tmLanguage.json"
            }
        ],
        "configuration": [
            {
                "title": "Language Server",
                "properties": {
                    "language-mixal.server.path": {
                        "type": [
                            "null",
                            "string"
                        ],
                        "scope": "machine-overridable",
                        "default": "null",
                        "markdownDescription": "Path to mixls executable. (Defaults to bundled binary.)"
                    },
                    "language-mixal.server.env": {
                        "type": [
                            "null",
                            "object"
                        ],
                        "additionalProperties": {
                            "type": "string"
                        },
                        "markdownDescription": "Environment variables to pass to mixls."
                    },
                    "language-mixal.server.args": {
                        "type": "array",
                        "default": [],
                        "items": {
                            "type": "string"
                        },
                        "markdownDescription": "Arguments to pass to mixls."
                    }
                }
            },
            {
                "properties": {
                    "language-mixal.trace.server": {
                        "scope": "window",
                        "type": "string",
                        "enum": [
                            "off",
                            "messages",
                            "verbose"
                        ],
                        "default": "verbose",
                        "markdownDescription": "Traces the communication between VS Code and the language server."
                    }
                }
            }
        ]
    },
    "icon": "./logo.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/jhunterkohler/mix"
    },
    "publisher": "jhunterkohler",
    "devDependencies": {
        "@types/node": "^26.1.2",
        "@types/vscode": "^1.125.0",
        "prettier": "^3.9.6",
        "typescript": "^5.9.3"
    },
    "main": "./out/extension.js",
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile",
        "test": "vscode-test"
    },
    "activationEvents": [
        "onLanguage:mixal",
        "onStartupFinished"
    ],
    "dependencies": {
        "vscode-languageclient": "^10.1.0"
    }
}
